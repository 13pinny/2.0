LYSTED_LOGIN_URL=https://lysted.com/login
LYSTED_INVENTORY_URL=https://app.lysted.com/tickets
LYSTED_PURCHASES_URL=https://app.lysted.com/purchases
LYSTED_SALES_URL=https://app.lysted.com/sales

KARTIS_BACKUP_DIR=C:\Users\13pin\OneDrive\KartisBackups
KARTIS_BACKUP_KEEP_DAYS=30

# Where uploaded ticket files are stored. Defaults to ./attachments inside
# the repo. Since the repo lives in OneDrive, that gives us free cloud
# backup of the PDFs without extra config.
KARTIS_ATTACHMENTS_DIR=

# --- Mail intake (purchase-confirmation emails → /pending Inbox) -------
# Reuses GMAIL_USER + GMAIL_APP_PASSWORD above. Forward purchase emails
# from Ticketmaster / Kupat / Tickchak to that Gmail address (or set up a
# Gmail filter that auto-forwards) and they'll appear in the /pending Inbox
# panel for you to confirm.

# Which Gmail label/folder to poll. Default is INBOX. If you set a Gmail
# filter to label purchase confirmations (e.g. "kartis-intake"), point this
# at that label so the poll only sees those messages.
KARTIS_INTAKE_FOLDER=

# How often to poll the inbox, in minutes. Default 10.
KARTIS_INTAKE_INTERVAL_MINUTES=

# Max messages to process per poll (defends against a backlog wedge). Default 25.
KARTIS_INTAKE_MAX_PER_POLL=

# By default we skip mail whose sender doesn't match a known provider hint
# (Ticketmaster, Kupat, Tickchak). Set to 1 to ingest everything — useful
# only when piloting with a dedicated Gmail label.
KARTIS_INTAKE_ALLOW_UNKNOWN=

# Ticketmaster.co.il drop checker
# Discord webhook: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=
# Gmail SMTP — needs an App Password (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
# How often to poll Ticketmaster (seconds). Default 60.
TM_CHECK_INTERVAL_SECONDS=60
