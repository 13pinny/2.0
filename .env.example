LYSTED_LOGIN_URL=https://lysted.com/login
LYSTED_INVENTORY_URL=https://app.lysted.com/tickets
LYSTED_PURCHASES_URL=https://app.lysted.com/purchases
LYSTED_SALES_URL=https://app.lysted.com/sales

KARTIS_BACKUP_DIR=C:\Users\13pin\OneDrive\KartisBackups
KARTIS_BACKUP_KEEP_DAYS=30

# Where uploaded ticket files are stored. Defaults to ./attachments inside
# the repo. Since the repo lives in OneDrive, that gives us free cloud
# backup of the PDFs without extra config.
KARTIS_ATTACHMENTS_DIR=

# --- Mail intake (purchase-confirmation emails → /pending Inbox) -------
# Reuses GMAIL_USER + GMAIL_APP_PASSWORD above. Forward purchase emails
# from Ticketmaster / Kupat / Tickchak to that Gmail address (or set up a
# Gmail filter that auto-forwards) and they'll appear in the /pending Inbox
# panel for you to confirm.

# Which Gmail label/folder to poll. Default is INBOX. If you set a Gmail
# filter to label purchase confirmations (e.g. "kartis-intake"), point this
# at that label so the poll only sees those messages.
KARTIS_INTAKE_FOLDER=

# How often to poll the inbox, in minutes. Default 10.
KARTIS_INTAKE_INTERVAL_MINUTES=

# Max messages to process per poll (defends against a backlog wedge). Default 25.
KARTIS_INTAKE_MAX_PER_POLL=

# By default we skip mail whose sender doesn't match a known provider hint
# (Ticketmaster, Kupat, Tickchak). Set to 1 to ingest everything — useful
# only when piloting with a dedicated Gmail label.
KARTIS_INTAKE_ALLOW_UNKNOWN=

# Ticketmaster.co.il drop checker
# Discord webhook: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=
# Optional per-category webhooks (one channel each; unset = falls back to
# DISCORD_WEBHOOK_URL). See _WEBHOOK_ENV in notify.py for the full list:
# DISCORD_WEBHOOK_DROPS= / _STATUS= / _NEW_EVENTS= / _JUMPS= / _SHOCKS=
# / _PRICER= / _LISTINGS= / _TODOS=
# SHOCKS (pacha price DROPS) is special: when unset, the Discord bot
# (DISCORD_BOT_TOKEN + DISCORD_GUILD_ID) auto-creates a #pacha-shocks
# channel before falling back to the main webhook.
# Gmail SMTP — needs an App Password (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
# How often to poll Ticketmaster (seconds). Default 60.
TM_CHECK_INTERVAL_SECONDS=60

# Set to 0 on the PC/dashboard when the drop-checker runs on another machine
# (e.g. the VPS watcher). The dashboard still serves inventory/sales and the
# manual "check now" button, but stops the periodic poll so you don't get
# duplicate Discord/email pings. Default 1 (enabled).
TM_CHECK_ENABLED=1

# --- Watcher-only box (supervisor.py) ---
# Which requirements file the supervisor refreshes after a git pull. The
# watcher VPS sets this to requirements-watcher.txt (lean: no Flask/patchright).
# The systemd unit deploy/systemd/kartis-watcher.service sets this already.
# KARTIS_REQUIREMENTS=requirements-watcher.txt
# How often the supervisor git-pulls + restarts on new commits (seconds). Default 300.
# KARTIS_PULL_INTERVAL_SECONDS=300
# Optional: pin the watcher to a specific branch (default = whatever is checked out).
# KARTIS_GIT_BRANCH=

# --- VPS deploy (ignored on local Windows dev) ---
# Path to the Chrome/Chromium binary. Leave unset to use the auto-detect
# list in login.py (handles Windows/macOS/Linux). Set explicitly on the
# VPS to skip the search.
# KARTIS_CHROME_BIN=/usr/bin/chromium

# CDP URL the scraper attaches to. Default matches local Chrome on 9222.
# KARTIS_CDP_URL=http://localhost:9222

# Phase 2 only: dedicated Viagogo Chrome on a different port, behind a
# residential proxy. When unset, Viagogo uses the same Chrome as
# everything else (current behavior).
# KARTIS_CDP_URL_VIAGOGO=http://localhost:9223

# /vault account manager — Fernet key that encrypts stored passwords/cards.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes the vault data unrecoverable — keep a copy off-server.
KARTIS_VAULT_KEY=

# --- US EDM event trackers (posh.vip / events.leapevents.com /
# wl.eventim.us — the /edm page and edm_events.py) ---
# Pure HTTP, so it runs anywhere; exactly ONE machine may enable it or
# Discord gets double pings. Prod = the VPS, so a locally-run dashboard
# sets this to 0 (same rule as the pacha / il-events monitors).
KARTIS_EDM_MONITOR_ENABLED=1

# Poll interval. Waves on these platforms sell out in minutes and returns
# re-list without warning, so keep it tight.
# KARTIS_EDM_MONITOR_INTERVAL_MINUTES=2

# Ping once when the current release's remaining count crosses at/below
# this. Only Posh publishes counts — Leap publishes none and Eventim only
# reveals one under its per-order limit — so this effectively gates Posh.
# KARTIS_EDM_LOW_STOCK_THRESHOLD=20

# How often the tick also writes a /market row + availability snapshot.
# KARTIS_EDM_MARKET_SNAPSHOT_MINUTES=10

# How long a posh event's cached id/metadata is reused before the event
# page is re-read (waves always come fresh from the API).
# KARTIS_POSH_META_TTL_SECONDS=21600
