{
  "name": "Kartis",
  "short_name": "Kartis",
  "description": "Ticket reseller dashboard — pricing, inventory, watchers, sales",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/static/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pricer", "url": "/pricer", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inventory", "url": "/", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Watchers", "url": "/watchers", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Profit", "url": "/profit", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] }
  ]
}
