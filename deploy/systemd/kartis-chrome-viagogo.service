[Unit]
Description=Kartis Chrome (dedicated Viagogo session through residential proxy) - Phase 2 only
Requires=kartis-xvfb.service
After=kartis-xvfb.service

[Service]
Type=simple
User=kartis
Group=kartis
WorkingDirectory=/opt/kartis
Environment=DISPLAY=:99
# Phase 2 only. Enable when Phase 1 still 403s on Viagogo.
# NEVER-DEPLOYED DRAFT — port moved 9223 -> 9224 (9223 is now the live
# CrowdVolt Chrome, kartis-chrome-cv). Also note --proxy-server silently
# drops user:pass — if this is ever enabled, chain through a cvproxy.py-
# style local forwarder instead of PROXY_URL credentials.
EnvironmentFile=/etc/kartis/viagogo-proxy.env
ExecStart=/usr/bin/chromium \
    --remote-debugging-port=9224 \
    --remote-allow-origins=* \
    --user-data-dir=/opt/kartis/user_data_viagogo \
    --proxy-server=${PROXY_URL} \
    --no-first-run \
    --no-default-browser-check
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
