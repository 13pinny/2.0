[Unit]
Description=Kartis window manager on the Xvfb display (raise/move the Chrome windows in noVNC)
Requires=kartis-xvfb.service
After=kartis-xvfb.service

[Service]
Type=simple
User=kartis
Group=kartis
Environment=DISPLAY=:99
ExecStart=/usr/bin/openbox
# Never let the OOM killer pick the display: losing Xvfb takes every window
# with it and noVNC shows a black screen. Chrome (+500) goes first instead.
OOMScoreAdjust=-900
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
