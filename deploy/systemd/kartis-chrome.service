[Unit]
Description=Kartis Chrome (CDP target for scraper, Lysted/Viagogo/CrowdVolt session)
Requires=kartis-xvfb.service
After=kartis-xvfb.service

[Service]
Type=simple
User=kartis
Group=kartis
WorkingDirectory=/opt/kartis
Environment=DISPLAY=:99
# --remote-allow-origins=* required since Chrome 111+ silently drops CDP
# WebSocket upgrades without an allowlisted origin. Same flag login.py
# already sets on local dev (commit f14bbc9). Safe because Chrome only
# listens on localhost.
ExecStart=/usr/bin/chromium \
    --remote-debugging-port=9222 \
    --remote-allow-origins=* \
    --user-data-dir=/opt/kartis/user_data \
    --renderer-process-limit=4 \
    --disk-cache-size=104857600 \
    --no-first-run \
    --no-default-browser-check \
    --disable-features=Translate \
    --disable-background-networking
# Memory: on the 4 GB box a runaway Chrome used to drag the whole system
# into the OOM killer, which then took Xvfb/x11vnc too (black noVNC). Now
# Chrome is reclaimed hard past MemoryHigh, killed+restarted past
# MemoryMax, and is the OOM killer's first choice — never the display.
MemoryHigh=1200M
MemoryMax=1600M
OOMScoreAdjust=500
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
